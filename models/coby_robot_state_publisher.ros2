robot_state_publisher:
  artifacts:
    robot_state_publisher:
      node: /coby_robot_state_publisher
      publishers:
        'robot_description':
          type: 'std_msgs/msg/String'
          qos:
          # profile:
          # history: UNKNOWN
          # depth:
            reliability: reliable
            durability: transient_local
        'tf':
          type: 'tf2_msgs/msg/TFMessage'
          qos:
          # profile:
          # history: UNKNOWN
          # depth:
            reliability: reliable
            durability: volatile
        'tf_static':
          type: 'tf2_msgs/msg/TFMessage'
          qos:
          # profile:
          # history: UNKNOWN
          # depth:
            reliability: reliable
            durability: transient_local
      subscribers:
        'joint_states':
          type: 'sensor_msgs/msg/JointState'
