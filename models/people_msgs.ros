people_msgs:
  msgs:
    People
        message
            "std_msgs/msg/Header" header
            "people_msgs/msg/Person"[] people
    Person
        message
            string name
            "geometry_msgs/msg/Point" position
            "geometry_msgs/msg/Point" velocity
            float64 reliability
            string[] tagnames
            string[] tags
    PersonStamped
        message
            "std_msgs/msg/Header" header
            "people_msgs/msg/Person" person
    PositionMeasurement
        message
            "std_msgs/msg/Header" header
            string name
            string object_id
            "geometry_msgs/msg/Point" pos
            float64 reliability
            float64 covariance
            byte initialization
    PositionMeasurementArray
        message
            "std_msgs/msg/Header" header
            "people_msgs/msg/PositionMeasurement"[] people
            float32[] cooccurrence
