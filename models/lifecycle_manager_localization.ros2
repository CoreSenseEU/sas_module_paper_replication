nav2_lifecycle_manager:
  artifacts:
    lifecycle_manager:
      node: lifecycle_manager_localization
      publishers:
        'bond':
          type: 'bond/msg/Status'
          qos:
          # profile:
          # history: UNKNOWN
          # depth:
            reliability: reliable
            durability: volatile
        'diagnostics':
          type: 'diagnostic_msgs/msg/DiagnosticArray'
          qos:
          # profile:
          # history: UNKNOWN
          # depth:
            reliability: reliable
            durability: volatile
      subscribers:
        'bond':
          type: 'bond/msg/Status'
      serviceservers:
        'lifecycle_manager_localization/get_type_description':
          type: 'type_description_interfaces/srv/GetTypeDescription'
        'lifecycle_manager_localization/is_active':
          type: 'std_srvs/srv/Trigger'
        'lifecycle_manager_localization/manage_nodes':
          type: 'nav2_msgs/srv/ManageLifecycleNodes'
      parameters:
        '/bond_disable_heartbeat_timeout':
          type: Boolean
          value: false
        'attempt_respawn_reconnection':
          type: Boolean
          value: true
        'autostart':
          type: Boolean
          value: true
        'bond_respawn_max_duration':
          type: Double
          value: 10.0
        'bond_timeout':
          type: Double
          value: 4.0
        'diagnostic_updater.period':
          type: Double
          value: 1.0
        'diagnostic_updater.use_fqn':
          type: Boolean
          value: false
        'node_names':
          type: Array[String]
          value: ['map_server', 'amcl']
        'start_type_description_service':
          type: Boolean
          value: true
        'use_sim_time':
          type: Boolean
          value: false
