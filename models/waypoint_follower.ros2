nav2_waypoint_follower:
  artifacts:
    waypoint_follower:
      node: waypoint_follower
      publishers:
        'bond':
          type: 'bond/msg/Status'
          qos:
          # profile:
          # history: UNKNOWN
          # depth:
            reliability: reliable
            durability: volatile
        'waypoint_follower/transition_event':
          type: 'lifecycle_msgs/msg/TransitionEvent'
          qos:
          # profile:
          # history: UNKNOWN
          # depth:
            reliability: reliable
            durability: volatile
      subscribers:
        'bond':
          type: 'bond/msg/Status'
      actionservers:
        'follow_gps_waypoints':
          type: 'nav2_msgs/action/FollowGPSWaypoints'
        'follow_waypoints':
          type: 'nav2_msgs/action/FollowWaypoints'
      actionclients:
        'navigate_to_pose':
          type: 'nav2_msgs/action/NavigateToPose' 
      serviceservers:
        'waypoint_follower/change_state':
          type: 'lifecycle_msgs/srv/ChangeState'
        'waypoint_follower/get_available_states':
          type: 'lifecycle_msgs/srv/GetAvailableStates'
        'waypoint_follower/get_available_transitions':
          type: 'lifecycle_msgs/srv/GetAvailableTransitions'
        'waypoint_follower/get_state':
          type: 'lifecycle_msgs/srv/GetState'
        'waypoint_follower/get_transition_graph':
          type: 'lifecycle_msgs/srv/GetAvailableTransitions'
        'waypoint_follower/get_type_description':
          type: 'type_description_interfaces/srv/GetTypeDescription'
      parameters:
        '/bond_disable_heartbeat_timeout':
          type: Boolean
          value: true
        'action_server_result_timeout':
          type: Double
          value: 900.0
        'autostart_node':
          type: Boolean
          value: false
        'bond_heartbeat_period':
          type: Double
          value: 0.1
        'global_frame_id':
          type: String
          value: "map"
        'loop_rate':
          type: Integer
          value: 20
        'start_type_description_service':
          type: Boolean
          value: true
        'stop_on_failure':
          type: Boolean
          value: false
        'use_sim_time':
          type: Boolean
          value: false
        'wait_at_waypoint.enabled':
          type: Boolean
          value: true
        'wait_at_waypoint.plugin':
          type: String
          value: "nav2_waypoint_follower::WaitAtWaypoint"
        'wait_at_waypoint.waypoint_pause_duration':
          type: Integer
          value: 200
        'waypoint_task_executor_plugin':
          type: String
          value: "wait_at_waypoint"
