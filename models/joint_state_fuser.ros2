bin:
  artifacts:
    python3:
      node: /joint_state_fuser
      publishers:
        'joint_states':
          type: 'sensor_msgs/msg/JointState'
          qos:
          # profile:
          # history: UNKNOWN
          # depth:
            reliability: reliable
            durability: volatile
      subscribers:
        'ridgeback/joint_states':
          type: 'sensor_msgs/msg/JointState'
        'robot_description':
          type: 'std_msgs/msg/String'
        'ur10/joint_states':
          type: 'sensor_msgs/msg/JointState'