ur_dashboard_msgs:
  msgs:
    SafetyMode
      message
       uint8 NORMAL=1
       uint8 REDUCED=2
       uint8 PROTECTIVE_STOP=3
       uint8 RECOVERY=4
       uint8 SAFEGUARD_STOP=5
       uint8 SYSTEM_EMERGENCY_STOP=6
       uint8 ROBOT_EMERGENCY_STOP=7
       uint8 VIOLATION=8
       uint8 FAULT=9
       uint8 VALIDATE_JOINT_ID=10
       uint8 UNDEFINED_SAFETY_MODE=11
       uint8 AUTOMATIC_MODE_SAFEGUARD_STOP=12
       uint8 SYSTEM_THREE_POSITION_ENABLING_STOP=13
       
       uint8 mode
    RobotMode
      message
       int8 NO_CONTROLLER=-1
       int8 DISCONNECTED=0
       int8 CONFIRM_SAFETY=1
       int8 BOOTING=2
       int8 POWER_OFF=3
       int8 POWER_ON=4
       int8 IDLE=5
       int8 BACKDRIVE=6
       int8 RUNNING=7
       int8 UPDATING_FIRMWARE=8
       
       int8 mode
    ProgramState
      message
       string STOPPED=STOPPED
       string PLAYING=PLAYING
       string PAUSED=PAUSED
       
       string state
  srvs:
    IsProgramSaved
      request
        
        string answer
        string program_name
        bool program_saved # is the current program saved?
        bool success # Did the dashboard server call succeed?
      response
        
        string answer
        string program_name
        bool program_saved # is the current program saved?
        bool success # Did the dashboard server call succeed?
    Popup
      request
        string message
        
        string answer
        bool success
      response
        string message
        
        string answer
        bool success
    IsProgramRunning
      request
        
        string answer
        bool program_running # is a program running?
        bool success # Did the dashboard server call succeed?
      response
        
        string answer
        bool program_running # is a program running?
        bool success # Did the dashboard server call succeed?
    AddToLog
      request
        string message
        
        string answer
        bool success
      response
        string message
        
        string answer
        bool success
    GetLoadedProgram
      request
        
        string answer
        string program_name
        bool success
      response
        
        string answer
        string program_name
        bool success
    GetProgramState
      request
        
        "ur_dashboard_msgs/msg/ProgramState" state
        string program_name
        string answer
        bool success
      response
        
        "ur_dashboard_msgs/msg/ProgramState" state
        string program_name
        string answer
        bool success
    GetRobotMode
      request
        
        "ur_dashboard_msgs/msg/RobotMode" robot_mode
        string answer
        bool success
      response
        
        "ur_dashboard_msgs/msg/RobotMode" robot_mode
        string answer
        bool success
    RawRequest
      request
        string query
        
        string answer
      response
        string query
        
        string answer
    IsInRemoteControl
      request
        
        string answer
        bool remote_control # is the robot in remote control?
        bool success # Did the dashboard server call succeed?
      response
        
        string answer
        bool remote_control # is the robot in remote control?
        bool success # Did the dashboard server call succeed?
    GetSafetyMode
      request
        
        "ur_dashboard_msgs/msg/SafetyMode" safety_mode
        string answer
        bool success
      response
        
        "ur_dashboard_msgs/msg/SafetyMode" safety_mode
        string answer
        bool success
    Load
      request
        string filename
        
        string answer
        bool success
      response
        string filename
        
        string answer
        bool success
