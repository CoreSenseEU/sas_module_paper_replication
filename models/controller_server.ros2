nav2_controller:
  artifacts:
    controller_server:
      node: controller_server
      publishers:
        'bond':
          type: 'bond/msg/Status'
          qos:
          # profile:
          # history: UNKNOWN
          # depth:
            reliability: reliable
            durability: volatile
        'cmd_vel_nav':
          type: 'geometry_msgs/msg/Twist'
          qos:
          # profile:
          # history: UNKNOWN
          # depth:
            reliability: reliable
            durability: volatile
        'controller_server/transition_event':
          type: 'lifecycle_msgs/msg/TransitionEvent'
          qos:
          # profile:
          # history: UNKNOWN
          # depth:
            reliability: reliable
            durability: volatile
        'optimal_trajectory':
          type: 'nav_msgs/msg/Path'
          qos:
          # profile:
          # history: UNKNOWN
          # depth:
            reliability: reliable
            durability: volatile
        'trajectories':
          type: 'visualization_msgs/msg/MarkerArray'
          qos:
          # profile:
          # history: UNKNOWN
          # depth:
            reliability: reliable
            durability: volatile
        'transformed_global_plan':
          type: 'nav_msgs/msg/Path'
          qos:
          # profile:
          # history: UNKNOWN
          # depth:
            reliability: reliable
            durability: volatile
      subscribers:
        'bond':
          type: 'bond/msg/Status'
        'odom':
          type: 'nav_msgs/msg/Odometry'
        'speed_limit':
          type: 'nav2_msgs/msg/SpeedLimit'
      actionservers:
        'follow_path':
          type: 'nav2_msgs/action/FollowPath'
      serviceservers:
        'controller_server/change_state':
          type: 'lifecycle_msgs/srv/ChangeState'
        'controller_server/get_available_states':
          type: 'lifecycle_msgs/srv/GetAvailableStates'
        'controller_server/get_available_transitions':
          type: 'lifecycle_msgs/srv/GetAvailableTransitions'
        'controller_server/get_state':
          type: 'lifecycle_msgs/srv/GetState'
        'controller_server/get_transition_graph':
          type: 'lifecycle_msgs/srv/GetAvailableTransitions'
        'controller_server/get_type_description':
          type: 'type_description_interfaces/srv/GetTypeDescription'
      parameters:
        '.position_checker.stateful':
          type: Boolean
          value: true
        '.position_checker.xy_goal_tolerance':
          type: Double
          value: 0.25
        '/bond_disable_heartbeat_timeout':
          type: Boolean
          value: true
        'FollowPath.ConstraintCritic.cost_power':
          type: Integer
          value: 1
        'FollowPath.ConstraintCritic.cost_weight':
          type: Double
          value: 4.0
        'FollowPath.ConstraintCritic.enabled':
          type: Boolean
          value: true
        'FollowPath.CostCritic.collision_cost':
          type: Double
          value: 1000000.0
        'FollowPath.CostCritic.consider_footprint':
          type: Boolean
          value: true
        'FollowPath.CostCritic.cost_power':
          type: Integer
          value: 1
        'FollowPath.CostCritic.cost_weight':
          type: Double
          value: 3.81
        'FollowPath.CostCritic.critical_cost':
          type: Double
          value: 300.0
        'FollowPath.CostCritic.enabled':
          type: Boolean
          value: true
        'FollowPath.CostCritic.inflation_layer_name':
          type: String
          value: ""
        'FollowPath.CostCritic.near_collision_cost':
          type: Integer
