nav2_bt_navigator:
  artifacts:
    bt_navigator:
      node: bt_navigator
      publishers:
        'bond':
          type: 'bond/msg/Status'
          qos:
          # profile:
          # history: UNKNOWN
          # depth:
            reliability: reliable
            durability: volatile
        'bt_navigator/transition_event':
          type: 'lifecycle_msgs/msg/TransitionEvent'
          qos:
          # profile:
          # history: UNKNOWN
          # depth:
            reliability: reliable
            durability: volatile
      subscribers:
        'bond':
          type: 'bond/msg/Status'
        'goal_pose':
          type: 'geometry_msgs/msg/PoseStamped'
        'odom':
          type: 'nav_msgs/msg/Odometry'
        'tf':
          type: 'tf2_msgs/msg/TFMessage'
        'tf_static':
          type: 'tf2_msgs/msg/TFMessage'
      actionservers:
        'navigate_through_poses':
          type: 'nav2_msgs/action/NavigateThroughPoses'
        'navigate_to_pose':
          type: 'nav2_msgs/action/NavigateToPose'
      actionclients:
        'navigate_to_pose':
          type: 'nav2_msgs/action/NavigateToPose'
      serviceservers:
        'bt_navigator/change_state':
          type: 'lifecycle_msgs/srv/ChangeState'
        'bt_navigator/get_available_states':
          type: 'lifecycle_msgs/srv/GetAvailableStates'
        'bt_navigator/get_available_transitions':
          type: 'lifecycle_msgs/srv/GetAvailableTransitions'
        'bt_navigator/get_state':
          type: 'lifecycle_msgs/srv/GetState'
        'bt_navigator/get_transition_graph':
          type: 'lifecycle_msgs/srv/GetAvailableTransitions'
        'bt_navigator/get_type_description':
          type: 'type_description_interfaces/srv/GetTypeDescription'
      parameters:
        '/bond_disable_heartbeat_timeout':
          type: Boolean
          value: true
        'action_server_result_timeout':
          type: Double
          value: 900.0
        'always_reload_bt_xml':
          type: Boolean
          value: false
        'autostart_node':
          type: Boolean
          value: false
        'bond_heartbeat_period':
          type: Double
          value: 0.1
        'bt_loop_duration':
          type: Integer
          value: 10
        'default_nav_through_poses_bt_xml':
          type: String
          value: "/opt/ros/jazzy/share/nav2_bt_navigator/behavior_trees/navigate_through_poses_w_replanning_and_recovery.xml"
        'default_nav_to_pose_bt_xml':
          type: String
          value: "/opt/ros/jazzy/share/nav2_bt_navigator/behavior_trees/navigate_to_pose_w_replanning_and_recovery.xml"
        'default_server_timeout':
          type: Integer
          value: 20
        'error_code_names':
          type: Array[String]
          value: ['follow_path_error_code', 'compute_path_error_code']
        'global_frame':
          type: String
          value: "map"
        'goal_blackboard_id':
          type: String
          value: "goal"
        'goals_blackboard_id':
          type: String
          value: "goals"
        'navigate_through_poses.plugin':
          type: String
          value: "nav2_bt_navigator::NavigateThroughPosesNavigator"
        'navigate_to_pose.plugin':
          type: String
          value: "nav2_bt_navigator::NavigateToPoseNavigator"
        'navigators':
          type: Array[String]
          value: ['navigate_to_pose', 'navigate_through_poses']
        'odom_topic':
          type: String
          value: "/odom"
        'path_blackboard_id':
          type: String
          value: "path"
        'plugin_lib_names':
          type: Array[String]
          value: '[]'
        'robot_base_frame':
          type: String
          value: "base_link"
        'start_type_description_service':
          type: Boolean
          value: true
        'transform_tolerance':
          type: Double
          value: 0.1
        'use_sim_time':
          type: Boolean
          value: false
        'wait_for_service_timeout':
          type: Integer
          value: 1000
