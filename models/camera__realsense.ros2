realsense2_camera:
  artifacts:
    realsense2_camera_node:
      node: realsense2_camera_node
      publishers:
        'realsense/accel/imu_info':
          type: 'realsense2_camera_msgs/msg/IMUInfo'
          qos:
          # profile:
          # history: UNKNOWN
          # depth:
            reliability: reliable
            durability: transient_local
        'realsense/accel/metadata':
          type: 'realsense2_camera_msgs/msg/Metadata'
          qos:
          # profile:
          # history: UNKNOWN
          # depth:
            reliability: reliable
            durability: volatile
        'realsense/accel/sample':
          type: 'sensor_msgs/msg/Imu'
          qos:
          # profile:
          # history: UNKNOWN
          # depth:
            reliability: best_effort
            durability: volatile
        'realsense/color/camera_info':
          type: 'sensor_msgs/msg/CameraInfo'
          qos:
          # profile:
          # history: UNKNOWN
          # depth:
            reliability: reliable
            durability: volatile
        'realsense/color/image_raw':
          type: 'sensor_msgs/msg/Image'
          qos:
          # profile:
          # history: UNKNOWN
          # depth:
            reliability: reliable
            durability: transient_local
        'realsense/color/metadata':
          type: 'realsense2_camera_msgs/msg/Metadata'
          qos:
          # profile:
          # history: UNKNOWN
          # depth:
            reliability: reliable
            durability: volatile
        'realsense/depth/camera_info':
          type: 'sensor_msgs/msg/CameraInfo'
          qos:
          # profile:
          # history: UNKNOWN
          # depth:
            reliability: reliable
            durability: volatile
        'realsense/depth/image_rect_raw':
          type: 'sensor_msgs/msg/Image'
          qos:
          # profile:
          # history: UNKNOWN
          # depth:
            reliability: reliable
            durability: transient_local
        'realsense/depth/metadata':
          type: 'realsense2_camera_msgs/msg/Metadata'
          qos:
          # profile:
          # history: UNKNOWN
          # depth:
            reliability: reliable
            durability: volatile
        'realsense/extrinsics/depth_to_accel':
          type: 'realsense2_camera_msgs/msg/Extrinsics'
          qos:
          # profile:
          # history: UNKNOWN
          # depth:
            reliability: reliable
            durability: transient_local
        'realsense/extrinsics/depth_to_color':
          type: 'realsense2_camera_msgs/msg/Extrinsics'
          qos:
          # profile:
          # history: UNKNOWN
          # depth:
            reliability: reliable
            durability: transient_local
        'realsense/extrinsics/depth_to_gyro':
          type: 'realsense2_camera_msgs/msg/Extrinsics'
          qos:
          # profile:
          # history: UNKNOWN
          # depth:
            reliability: reliable
            durability: transient_local
        'realsense/gyro/imu_info':
          type: 'realsense2_camera_msgs/msg/IMUInfo'
          qos:
          # profile:
          # history: UNKNOWN
          # depth:
            reliability: reliable
            durability: transient_local
        'realsense/gyro/metadata':
          type: 'realsense2_camera_msgs/msg/Metadata'
          qos:
          # profile:
          # history: UNKNOWN
          # depth:
            reliability: reliable
            durability: volatile
        'realsense/gyro/sample':
          type: 'sensor_msgs/msg/Imu'
          qos:
          # profile:
          # history: UNKNOWN
          # depth:
            reliability: best_effort
            durability: volatile
        'ic':
          type: 'tf2_msgs/msg/TFMessage'
          qos:
          # profile:
          # history: UNKNOWN
          # depth:
            reliability: reliable
            durability: transient_local
      actionservers:
        'realsense/triggered_calibration':
          type: 'realsense2_camera_msgs/action/TriggeredCalibration'
      serviceservers:
        'realsense/calib_config_read':
          type: 'realsense2_camera_msgs/srv/CalibConfigRead'
        'realsense/calib_config_write':
